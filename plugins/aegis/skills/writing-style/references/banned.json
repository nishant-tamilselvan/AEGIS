      "pattern": "^\\s*(there (is|are) [^.!?\\n]{5,50} (that|which)|it is (important|worth|essential|critical) to)\\b",
      "label": "expletive-opening"
    },
    {
      "pattern": "\\b(answers?|solves?|addresses?|covers?|handles?|fixes|does) (both|all|three|two|this|these|the) [^.!?\\n]{0,30}: (it|they|you|we) ",
      "label": "cataphoric-announcement"
    },
    {
      "pattern": "\\b(the|a|an|every|each|any|this|that|those|these)\\s+[\\w'-]+\\s+(that|which|it|they|we|you|i)\\s+(needs?|wants?|holds?|carries|carry|uses?|makes?|does|do|gives?|takes?|sees?|reads?|writes?|cites?|answers?|covers?|serves?|supports?|produced?|created?|built|wrote|found|left|kept)\\s*[.!?]?$",
      "label": "verb-final-relative"
    },
    {
      "pattern": "^[^.!?\\n]{15,}\\b(that|which|it|they|we|you|i)\\s+[\\w'-]+\\s+(about|at|for|from|to|with|on|in|into|through|under|over|by)\\s*[.!?]?$",
      "label": "terminal-stranded-preposition"
    },
    {
      "pattern": "\\b(is|are|was|were|be|been|being)\\s+(dropped|removed|deleted|enforced|computed|recorded|checked|validated|written|drafted|applied|required|considered|maintained|leveraged|utilized|utilised|ensured|facilitated|addressed|undertaken|actioned)\\s*[.!?]?$",
      "label": "terminal-agentless-passive"
    }
  ],
  "limits": {
    "em_dash_max": 1,
    "sentence_words_warn": 30,
    "sentence_words_error": 40,
    "cadence_min_sentences": 8,
    "cadence_cv_floor": 0.28,
    "personification_per_1k": 2.5
  }
